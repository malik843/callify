<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml — Callify main shell.

    Structure:
    ┌────────────────────────────────┐  ← sage-green header (52dp)
    │           Callify              │
    ├────────────────────────────────┤
    │                                │
    │        ViewPager2              │  ← fills all remaining space
    │   (DialPad / Permissions)      │
    │                                │
    ├────────────────────────────────┤
    │      ╔══════════════╗          │
    │      ║  ▦  │  ⚙    ║          │  ← compact pill nav, centred
    │      ╚══════════════╝          │
    └────────────────────────────────┘
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".MainActivity">

    <!-- ── Header ──────────────────────────────────────────────────── -->
    <View
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#A8B4A8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:fontFamily="serif"
        android:textStyle="italic"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.04"
        app:layout_constraintTop_toTopOf="@id/headerBar"
        app:layout_constraintBottom_toBottomOf="@id/headerBar"
        app:layout_constraintStart_toStartOf="@id/headerBar"
        app:layout_constraintEnd_toEndOf="@id/headerBar" />

    <!-- ── Paged content ───────────────────────────────────────────── -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Bottom tab pill ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_bottom_nav_pill"
        android:orientation="horizontal"
        android:padding="4dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dialpad tab — selected by default (white oval background) -->
        <ImageButton
            android:id="@+id/tabDial"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tab_selected"
            android:src="@drawable/ic_dailpad"
            android:padding="13dp"
            android:tint="#1A1A1A"
            android:scaleType="fitCenter"
            android:contentDescription="Dial tab" />

        <!-- Permissions / settings tab -->
        <ImageButton
            android:id="@+id/tabPermissions"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_settings"
            android:padding="13dp"
            android:tint="#888888"
            android:scaleType="fitCenter"
            android:contentDescription="Settings tab" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>